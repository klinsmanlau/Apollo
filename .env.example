# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Transaction" pooler URL (port 6543) for the app runtime,
# and the "Session"/direct URL (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Clerk Auth ------------------------------------------------------------
# Clerk dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk dashboard -> Webhooks -> create endpoint for user.created / user.updated
# / user.deleted pointing at https://<your-app>/api/webhooks/clerk , then copy
# the signing secret here.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- DeviceCloud webhook ---------------------------------------------------
# Shared secret for the DeviceCloud "upload.completed" webhook. Set the same
# value as the webhook secret in the DeviceCloud console (it sends it as the
# X-DeviceCloud-Secret header). Endpoint: /api/webhooks/devicecloud/<projectId>
DEVICECLOUD_WEBHOOK_SECRET="change-me"

# --- Supabase Storage (attachment files) -----------------------------------
# When set, attachment bytes are stored in a private Storage bucket instead of
# the Postgres `Attachment.data` column. Leave blank to keep bytes in Postgres.
# Service-role key: Supabase dashboard -> Project Settings -> API -> service_role
# (secret; server-only). SUPABASE_URL is optional — it's derived from the
# project ref in DATABASE_URL when omitted. Bucket must exist and be PRIVATE.
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_STORAGE_BUCKET="attachments"

# --- Jira Cloud (linked issues in the Test Player) --------------------------
# When set, the "Issues" panel validates existing keys against Jira and lets
# testers create new issues in-app (project + issue type pulled live from
# Jira). Leave blank to keep the panel in format-only mode (no API calls).
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL="https://yourcompany.atlassian.net"
JIRA_EMAIL="you@yourcompany.com"
JIRA_API_TOKEN=""

# --- Jira issue panel (Forge app in /jira-panel-app) ------------------------
# Shared secret the Forge app's resolver sends as X-Apollo-Panel-Secret when
# it calls /api/jira-panel/executions to list a Jira issue's linked Apollo
# test executions. Set the same value with:
#   forge variables set --environment development APOLLO_PANEL_SECRET <value>
# NEXT_PUBLIC_APP_URL must be Apollo's public URL (a deployed URL, or an ngrok
# URL while using `forge tunnel` for local dev) so the panel's links resolve.
JIRA_PANEL_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Zephyr Scale Cloud sync (temporary migration tool) --------------------
# API access token from Zephyr Scale Cloud (Jira -> Zephyr -> API Access Tokens).
# Used by: npx tsx prisma/zephyr-sync.ts <apolloProjectId> <zephyrProjectKey>
ZEPHYR_API_TOKEN=""

# --- Embedding (qa_dashboard "Test Cases" iframe) --------------------------
# Origin allowed to embed Apollo in an <iframe> via CSP frame-ancestors.
# Set to the dashboard's URL, e.g. https://qa.yourdomain.com. For the embedded
# session to stay authenticated, this origin should share Apollo's registrable
# domain (so the Clerk cookie is same-site). Also add it to Clerk allowed origins.
DASHBOARD_ORIGIN=""

# Where Clerk sends users. Defaults below match the app's routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/projects"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/projects"

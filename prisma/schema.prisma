// Apollo TCM — Prisma schema
// Data model per the build spec. Postgres (Supabase); identity via Clerk.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users & membership
// ---------------------------------------------------------------------------

enum Role {
  admin
  lead
  tester
  viewer
}

model User {
  id          String   @id @default(cuid())
  // Clerk's user id (e.g. "user_2abc..."). Kept in sync via the Clerk webhook.
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  role        Role     @default(tester)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships    ProjectMember[]
  createdCases   TestCase[]      @relation("CaseCreatedBy")
  executions     TestExecution[] @relation("ExecutedBy")
  attachments    Attachment[]    @relation("UploadedBy")
  assignedExecutions TestExecution[] @relation("AssignedTo")

  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Case-key prefix (e.g. "TS") and last-used sequence number. Case keys are
  // "<keyPrefix>-T<caseSeq>". Prefix is detected from imported Zephyr keys.
  keyPrefix   String?
  caseSeq     Int      @default(0)
  cycleSeq    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      ProjectMember[]
  suites       TestSuite[]
  runs         TestRun[]
  cycleFolders CycleFolder[]
}

// Join table: User <-> Project (many-to-many) with a per-project role.
// `User.role == admin` acts as a global-admin bypass; everyone else gets
// their capabilities from this per-project role.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(tester)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Suites (nestable folders) & Test Cases
// ---------------------------------------------------------------------------

model TestSuite {
  id            String   @id @default(cuid())
  projectId     String
  parentSuiteId String?
  name          String
  // User-defined ordering among siblings (lower = higher in the list).
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentSuite TestSuite?  @relation("SuiteTree", fields: [parentSuiteId], references: [id], onDelete: Cascade)
  children    TestSuite[] @relation("SuiteTree")
  cases       TestCase[]

  @@index([projectId])
  @@index([parentSuiteId])
  @@index([parentSuiteId, position])
}

enum Priority {
  low
  medium
  high
}

enum CaseType {
  functional
  regression
  smoke
  integration
  performance
  security
  usability
}

// Lifecycle state of a test case (mirrors Zephyr Scale's Draft/Approved/Deprecated).
enum CaseStatus {
  draft
  approved
  deprecated
}

// Which authoring format the test script uses.
enum ScriptType {
  steps // structured step-by-step (see `steps`)
  plain // free-form plain text (see `scriptBody`)
  bdd   // Gherkin / BDD (see `scriptBody`)
}

model TestCase {
  id             String   @id @default(cuid())
  suiteId        String
  title          String
  // Human-readable unique key shown in the UI (e.g. "TS-T7060"). For imported
  // cases this equals the Zephyr key; for new cases it is generated from the
  // project's prefix + sequence.
  key            String?  @unique
  // Numeric part of `key` (e.g. 7060) so the Key column sorts numerically.
  keyNum         Int?
  // Source system key (e.g. Zephyr "TS-T7060"). Preserved on import and used
  // to make re-imports idempotent. Nullable for manually-authored cases;
  // Postgres allows multiple NULLs under a unique constraint.
  sourceKey      String?  @unique
  objective      String?
  preconditions  String?

  // Script authoring. For scriptType=steps, `steps` holds an ordered list of
  // { action, testData?, expected? }. For plain/bdd, `scriptBody` holds the text.
  scriptType     ScriptType @default(steps)
  steps          Json       @default("[]")
  scriptBody     String?
  expectedResult String?

  priority       Priority   @default(medium)
  type           CaseType   @default(functional)
  status         CaseStatus @default(draft)
  component      String?
  ownerName      String?
  // Estimated execution time, in seconds (Zephyr's unit).
  estimatedTime  Int?
  tags           String[]   @default([])
  // Linked/covered issue keys (Zephyr "Coverage (Issues)").
  coverage       String[]   @default([])
  // Soft-archive: archived cases are hidden from the default list.
  archived       Boolean    @default(false)
  archivedAt     DateTime?
  // Optional single Jira issue key or other external reference.
  externalRef    String?
  // Lossless bag for source custom fields (Language, POD, Remarks, etc.).
  customFields   Json       @default("{}")

  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  suite       TestSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  executions  TestExecution[]
  attachmentFiles Attachment[]

  @@index([suiteId])
  @@index([tags])
  @@index([status])
  @@index([archived])
  @@index([keyNum])
}

// ---------------------------------------------------------------------------
// Runs / Cycles & Executions
// ---------------------------------------------------------------------------

// Test Cycle (a scheduled run of a set of cases).
model TestRun {
  id          String    @id @default(cuid())
  projectId   String
  // Human key (e.g. "TS-R96") + numeric part for sorting.
  key         String?   @unique
  keyNum      Int?
  name        String
  description String?
  status      CycleStatus @default(not_executed)
  environment String?
  version     String?
  iteration   String?
  ownerName   String?
  folderId    String?
  startDate   DateTime?
  endDate     DateTime?
  customFields Json     @default("{}")
  // Source run id (e.g. DeviceCloud upload_id) for webhook idempotency.
  externalRunId String? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     CycleFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  executions TestExecution[]

  @@index([projectId])
  @@index([folderId])
  @@index([keyNum])
}

// Nestable folders for test cycles (separate tree from test-case suites).
model CycleFolder {
  id             String   @id @default(cuid())
  projectId      String
  parentFolderId String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   CycleFolder?  @relation("CycleFolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children CycleFolder[] @relation("CycleFolderTree")
  cycles   TestRun[]

  @@index([projectId])
  @@index([parentFolderId])
}

// Manually-set lifecycle status of a test cycle (distinct from progress %).
enum CycleStatus {
  not_executed
  in_progress
  done
}

enum ExecutionStatus {
  not_executed
  in_progress
  pass
  fail
  blocked
}

model TestExecution {
  id             String          @id @default(cuid())
  runId          String
  caseId         String
  executedById   String?
  executedAt     DateTime?
  status         ExecutionStatus @default(not_executed)
  notes          String?
  // Jira / GitHub issue link for a logged defect.
  defectRef      String?
  // Screenshot / log URLs.
  attachments    String[]        @default([])
  // Per-step results (parallel to the case's steps): [{ status, at }].
  stepResults    Json            @default("[]")
  // Test Player execution details.
  environment    String?
  iteration      String?
  releaseVersion String?
  // Assignee: FK is authoritative; `assignedToName` is kept denormalized for
  // display and for legacy rows imported before the FK existed.
  assignedToId   String?
  assignedToName String?
  actualTime     Int? // seconds spent executing
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  run        TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  case       TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  executedBy User?    @relation("ExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  attachmentFiles Attachment[]

  // One execution row per (run, case).
  @@unique([runId, caseId])
  @@index([caseId])
  @@index([status])
  @@index([assignedToId, status])
  // Per-case execution history, newest first.
  @@index([caseId, executedAt])
}

// ---------------------------------------------------------------------------
// Attachments (screenshots / logs on executions and cases)
// ---------------------------------------------------------------------------

// File bytes live in Postgres (`data`) so no extra storage service is needed.
// If this outgrows the DB, swap `data` for an object-store path — the routes
// are the only readers. NOTE: never select `data` in list queries.
model Attachment {
  id           String   @id @default(cuid())
  // Exactly one of these is set (execution or case attachment).
  executionId  String?
  caseId       String?
  fileName     String
  mimeType     String
  size         Int // bytes
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  execution  TestExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  case       TestCase?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User?          @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Automation results (v2 — CI ingestion). Modeled now, unused in Phase 1.
// ---------------------------------------------------------------------------

model AutomationResult {
  id           String   @id @default(cuid())
  runId        String
  source       String // Maestro | Appium | Playwright | JUnit
  rawPayload   Json
  parsedStatus String?
  linkedCaseId String?
  createdAt    DateTime @default(now())

  @@index([runId])
}
